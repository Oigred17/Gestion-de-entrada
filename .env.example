# ============================================================
# COBAO - Variables de entorno del backend
# Copia este archivo a .env y llena los valores reales.
# ============================================================

# Clave secreta para firmar los JWT (OBLIGATORIA en produccion).
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esta-clave-en-produccion

# Llave de API para los lectores NFC externos (nfc_reader).
# OBLIGATORIA en produccion: sin ella los lectores no pueden enviar lecturas.
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
# y pon la misma en nfc_key.txt de cada PC con lector.
NFC_API_KEY=

# Origenes permitidos por CORS (separados por coma). Solo necesarios para el
# dev server de Vite; en produccion la SPA se sirve del mismo backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Longitud minima de contrasena (usa 8+ en produccion, 4 para pruebas).
MIN_PASSWORD_LENGTH=8

# Anti fuerza bruta en login/recuperacion.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_WINDOW_SECONDS=600

# Configuracion SMTP para envio de correos (recuperacion de contrasena).
# Para Gmail: usa una CONTRASENA DE APLICACION (no la contrasena normal).
# 1. Activa la verificacion en dos pasos en tu cuenta de Google.
# 2. Crea una contrasena de aplicacion en: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=TU_CORREO@gmail.com
SMTP_PASSWORD=TU_APP_PASSWORD
SMTP_FROM=
SMTP_USE_TLS=true

# Minutos de validez del codigo de recuperacion
RECOVERY_CODE_EXPIRE_MINUTES=10

# Cookie de autenticacion: True en produccion (HTTPS), False en desarrollo (HTTP).
COOKIE_SECURE=False
