DATABASE_URL=postgresql+asyncpg://cobao:cobao_pass@db:5432/cobao_db
SECRET_KEY=tu-clave-secreta-aqui-cambiar-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Llave de API para los lectores NFC externos. OBLIGATORIA en produccion:
# sin ella los lectores no pueden enviar lecturas (solo el frontend con su JWT).
NFC_API_KEY=

# Origenes CORS permitidos (separados por coma).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Longitud minima de contrasena (4 para pruebas, 8+ en produccion).
MIN_PASSWORD_LENGTH=4

POSTGRES_USER=cobao
POSTGRES_PASSWORD=cobao_pass
POSTGRES_DB=cobao_db
